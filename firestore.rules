rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /families/{family} {
      allow get, create, update: if request.auth != null;
      match /{collection}/{rest=**} {
        allow read, write: if request.auth != null;
      }
    }
    match /healthsync/{id} {
      allow get: if request.auth != null;
      allow create, update: if id.size() >= 34 && id.size() <= 60
        && request.resource.data.keys().hasOnly(['date', 'steps', 'active']);
    }
  }
}
